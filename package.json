{
  "name": "ghost-rank",
  "version": "0.1.0",
  "description": "LUMENEX: MMR de Dota 2, servidores, chat e voz",
  "private": true,
  "main": "src/main/main.js",
  "scripts": {
    "start": "electron .",
    "test": "node --test \"test/**/*.test.js\"",
    "audit": "npm audit --audit-level=high",
    "dist": "electron-builder --win portable --publish never"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "livekit-client": "^2.15.0"
  },
  "devDependencies": {
    "electron": "^45.3.3",
    "electron-builder": "^26.0.12",
    "esbuild": "^0.28.2"
  },
  "build": {
    "appId": "com.ghostrank.app",
    "productName": "LUMENEX",
    "files": [
      "src/**/*",
      "config.public.json",
      "package.json"
    ],
    "asar": true,
    "win": {
      "target": [
        "portable"
      ],
      "artifactName": "GhostRank-${version}.exe",
      "icon": "build/icon.png"
    },
    "directories": {
      "output": "dist",
      "buildResources": "build"
    }
  }
}
