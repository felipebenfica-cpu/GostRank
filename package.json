{
  "name": "ghost-rank",
  "version": "0.2.0",
  "description": "LUMENEX: MMR de Dota 2, servidores, chat e voz",
  "private": true,
  "main": "src/main/main.js",
  "scripts": {
    "start": "electron .",
    "test": "node --test \"test/**/*.test.js\"",
    "audit": "npm audit --audit-level=high",
    "dist": "electron-builder --win nsis portable --publish never"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "electron-updater": "^6.8.11",
    "livekit-client": "^2.15.0"
  },
  "devDependencies": {
    "electron": "^45.3.3",
    "electron-builder": "^26.0.12",
    "esbuild": "^0.28.2"
  },
  "build": {
    "appId": "com.ghostrank.app",
    "productName": "LUMENEX",
    "files": [
      "src/**/*",
      "config.public.json",
      "package.json"
    ],
    "asar": true,
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "build/icon.png"
    },
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "artifactName": "LUMENEX-Setup-${version}.exe",
      "shortcutName": "LUMENEX",
      "uninstallDisplayName": "LUMENEX",
      "deleteAppDataOnUninstall": false
    },
    "portable": {
      "artifactName": "GhostRank-${version}.exe"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "felipebenfica-cpu",
        "repo": "GostRank",
        "releaseType": "release"
      }
    ]
  }
}
